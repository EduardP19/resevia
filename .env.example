# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service-role key (server-only) — used by the blog seed endpoint to bypass RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Blog
# Secret that guards POST /api/blog/seed
BLOG_SEED_SECRET=choose_a_long_random_string
# Table used by the local blog agent scripts
BLOG_TABLE=blog_posts

# Resend
RESEND_API_KEY=your_resend_api_key

# Twilio (sms/whatsapp sending in the send-scheduled-messages Edge Function —
# also needs setting as Supabase secrets via `supabase secrets set`, this
# .env is just for local reference)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_SMS_FROM=your_twilio_sms_number
TWILIO_WHATSAPP_FROM=your_twilio_whatsapp_number

# Microsoft Clarity
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_id

# Meta Pixel
NEXT_PUBLIC_FACEBOOK_PIXEL_ID= key

# Postiz
POSTIZ_API_BASE_URL=your_postiz_api_base_url
POSTIZ_API_KEY=your_postiz_api_key
